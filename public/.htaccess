<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /files/lernplattform/public/

    # Statische Assets direkt ausliefern (CSS, JS, Bilder, Fonts)
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Bestehende Verzeichnisse direkt ausliefern
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Alles andere → Front-Controller (index.php)
    RewriteRule ^ index.php [L]
</IfModule>